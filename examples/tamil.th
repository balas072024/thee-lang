// ═══ THEE v6.0 — தமிழ் நிரலாக்கம் ═══
// Full Tamil Programming Example
// Run: thee tamil.th

மூச்சு "🇮🇳 தமிழ் நிரலாக்கம் — THEE v6.0"
மூச்சு "══════════════════════════════"
மூச்சு ""

// Variables in Tamil
நா பெயர் = "முருகன்"
நா வயது = 25
நா ஊர் = "சென்னை"
மூச்சு "பெயர்: " + பெயர்
மூச்சு "வயது: " + வயது
மூச்சு "ஊர்: " + ஊர்

// Function in Tamil
தீ வணக்கம்(நபர்) {
    கனல் "வணக்கம் " + நபர் + "! நலமா?"
}
மூச்சு ""
மூச்சு வணக்கம்("உலகம்")

// Class in Tamil
வகு மாணவன் {
    தீ init(பெயர், மதிப்பெண்) {
        self.பெயர் = பெயர்
        self.மதிப்பெண் = மதிப்பெண்
    }
    தீ தகுதி() {
        என்றால் self.மதிப்பெண் >= 50 {
            கனல் self.பெயர் + " — தேர்ச்சி ✅"
        } இல்லை {
            கனல் self.பெயர் + " — தோல்வி ❌"
        }
    }
}

நா மாணவர்கள் = [
    புது மாணவன்("அருண்", 85),
    புது மாணவன்("கவிதா", 92),
    புது மாணவன்("ராஜா", 45),
    புது மாணவன்("லதா", 78)
]

மூச்சு ""
மூச்சு "📚 மாணவர் பட்டியல்:"
ozhugu for m உள் மாணவர்கள் {
    மூச்சு "  " + m.தகுதி()
}

// Loop with Tamil
மூச்சு ""
மூச்சு "🔢 எண்கள்:"
ozhugu for i உள் range(1, 6) {
    மூச்சு "  " + i + " × " + i + " = " + (i * i)
}

மூச்சு ""
மூச்சு "✅ தமிழ் நிரல் வெற்றிகரமாக இயங்கியது!"
